{
  "name": "stellar-webapp",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "nuxt dev",
    "build": "cross-env NUXT_ENV=production nuxt generate",
    "build:sdk": "pnpm --filter sdk build",
    "build:ssg": "pnpm build:sdk && cross-env NUXT_ENV=production nuxt generate",
    "build:ssr": "cross-env NUXT_ENV=production nuxt build",
    "build:staging:ssg": "cross-env NUXT_ENV=staging nuxt generate",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "test": "vitest",
    "test:e2e": "cypress open",
    "test:unit": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "npx simple-git-hooks",
    "sizecheck": "ross-env  npx vite-bundle-visualizer"
  },
  "dependencies": {
    "@bootstrap-vue-next/nuxt": "^0.30.4",
    "@creit.tech/stellar-wallets-kit": "^1.7.7",
    "@floating-ui/vue": "^1.1.8",
    "@gtm-support/vue-gtm": "^3.1.0",
    "@pinia/nuxt": "^0.11.2",
    "@stellar/stellar-sdk": "14.0.0-rc.3",
    "@vueuse/nuxt": "^13.6.0",
    "axios": "^1.11.0",
    "bn.js": "^5.2.2",
    "bootstrap": "^5.3.7",
    "bootstrap-vue-next": "0.30.3",
    "buffer": "^6.0.3",
    "chart.js": "^4.5.0",
    "chartjs-adapter-luxon": "^1.3.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "decimal.js": "^10.6.0",
    "fastestsmallesttextencoderdecoder": "^1.0.22",
    "js-cookie": "^3.0.5",
    "lodash-es": "^4.17.21",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "nuxt": "^4.0.3",
    "pinia": "^3.0.3",
    "sdk": "workspace:^",
    "stellar-sdk": "^13.3.0",
    "vue": "^3.5.18",
    "vue-3-slider-component": "^1.0.2",
    "vue-chartjs": "^5.3.2",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.19.0",
    "@nuxt/types": "^2.18.1",
    "@nuxtjs/i18n": "^10.0.3",
    "@types/bn.js": "^5.2.0",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.2.0",
    "@vite-pwa/nuxt": "^1.0.4",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vueuse/core": "^13.6.0",
    "beasties": "^0.3.5",
    "cross-env": "^7.0.3",
    "eslint": "^9.32.0",
    "eslint-plugin-format": "^1.0.1",
    "eslint-plugin-vue": "^10.4.0",
    "lint-staged": "^16.1.4",
    "sass-embedded": "1.89.2",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.2",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-icons": "^22.2.0",
    "unplugin-imagemin": "^0.6.9",
    "unplugin-vue-components": "^28.8.0",
    "vite": "^6.3.5",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-node-polyfills": "^0.23.0",
    "vue-tsc": "^2.2.12"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
