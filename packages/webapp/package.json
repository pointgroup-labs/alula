{
  "name": "@alula/webapp",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "pnpm build:sdk && nuxt dev",
    "build": "cross-env NUXT_ENV=production nuxt generate",
    "build:market-sdk": "pnpm --dir ../sdk/market build && pnpm --dir ../sdk/market_manager build && pnpm --dir ../sdk/soroswap_router build && pnpm --dir ../sdk/soroswap_swap_provider build",
    "build:client-sdk": "pnpm -r --filter @alula/client-sdk run build",
    "build:sdk": "pnpm build:market-sdk && pnpm build:client-sdk",
    "build:ssg": "pnpm build:sdk && cross-env NUXT_ENV=production nuxt generate",
    "build:ssr": "cross-env NUXT_ENV=production nuxt build",
    "build:staging:ssg": "pnpm build:sdk && cross-env NUXT_ENV=staging nuxt generate",
    "preview": "npx serve dist",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "test": "vitest",
    "test:e2e": "cypress open",
    "test:unit": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "npx simple-git-hooks",
    "sizecheck": "cross-env  npx vite-bundle-visualizer"
  },
  "dependencies": {
    "@alula/client-sdk": "workspace:^",
    "@alula/market-manager-sdk": "link:../sdk/market_manager",
    "@alula/market-sdk": "link:../sdk/market",
    "@bootstrap-vue-next/nuxt": "^0.30.5",
    "@creit.tech/stellar-wallets-kit": "^1.9.5",
    "@dicebear/collection": "^9.3.2",
    "@dicebear/core": "^9.3.2",
    "@floating-ui/vue": "^1.1.9",
    "@gtm-support/vue-gtm": "^3.1.0",
    "@pinia/nuxt": "^0.11.3",
    "@stellar/stellar-sdk": "^14.4.3",
    "@vueuse/nuxt": "^13.9.0",
    "axios": "^1.13.2",
    "bn.js": "^5.2.2",
    "bootstrap": "^5.3.8",
    "bootstrap-vue-next": "0.30.3",
    "buffer": "^6.0.3",
    "chart.js": "^4.5.1",
    "chartjs-adapter-luxon": "^1.3.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "decimal.js": "^10.6.0",
    "echarts": "^6.0.0",
    "fastestsmallesttextencoderdecoder": "^1.0.22",
    "js-cookie": "^3.0.5",
    "lodash-es": "^4.17.23",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "nuxt": "^4.3.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.27",
    "vue-3-slider-component": "^1.0.2",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@nuxt/types": "^2.18.1",
    "@nuxtjs/i18n": "^10.2.1",
    "@types/bn.js": "^5.2.0",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.10.9",
    "@vite-pwa/nuxt": "^1.1.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vueuse/core": "^13.9.0",
    "beasties": "^0.3.5",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.2",
    "eslint-plugin-format": "^1.3.1",
    "eslint-plugin-vue": "^10.7.0",
    "lint-staged": "^16.2.7",
    "sass-embedded": "^1.97.3",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-icons": "^22.5.0",
    "unplugin-imagemin": "^0.6.9",
    "unplugin-vue-components": "^28.8.0",
    "unplugin-vue-router": "^0.19.2",
    "vite": "^7.3.1",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vue-tsc": "^3.2.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
